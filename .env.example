# Make webhook that receives validated leads. Leave empty to run the quiz in demo mode.
LEAD_WEBHOOK_URL=
# Optional bearer token sent to the webhook.
LEAD_WEBHOOK_SECRET=
# Google Tag Manager container, loaded only after analytics consent.
NEXT_PUBLIC_GTM_ID=
# Set to 1 to allow indexing (index,follow). Anything else serves noindex.
NEXT_PUBLIC_ALLOW_INDEXING=
# Public origin used for canonical and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=
